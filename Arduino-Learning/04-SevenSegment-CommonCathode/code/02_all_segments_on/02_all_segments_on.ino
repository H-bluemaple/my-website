void setup() {
  pinMode(2, OUTPUT); // a
  pinMode(3, OUTPUT); // b
  pinMode(4, OUTPUT); // c
  pinMode(5, OUTPUT); //d
  pinMode(6, OUTPUT); //e
  pinMode(7, OUTPUT); //f
  pinMode(8, OUTPUT); //g
  pinMode(9, OUTPUT); //dp

  digitalWrite(2, HIGH);
  digitalWrite(3, HIGH);
  digitalWrite(4, HIGH);
  digitalWrite(5, HIGH);
  digitalWrite(6, HIGH);
  digitalWrite(7, HIGH);
  digitalWrite(8, HIGH);
  digitalWrite(9, HIGH); 
}

void loop() {}
